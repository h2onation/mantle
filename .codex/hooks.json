{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // empty'); if echo \"$CMD\" | grep -qE '^git commit'; then '/Users/jeffwaters/mywalnut/.codex/hooks/pre-commit-test.sh'; fi",
            "timeout": 120,
            "statusMessage": "Running build check before commit..."
          },
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // empty'); if echo \"$CMD\" | grep -qE '^git commit'; then '/Users/jeffwaters/mywalnut/.codex/hooks/pre-commit-lint.sh'; fi",
            "timeout": 60,
            "statusMessage": "Running linter before commit..."
          },
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // empty'); if echo \"$CMD\" | grep -qE '^git commit'; then '/Users/jeffwaters/mywalnut/.codex/hooks/pre-commit-docs.sh'; fi",
            "timeout": 10,
            "statusMessage": "Checking if docs need updating..."
          },
          {
            "type": "command",
            "command": "INPUT=$(cat); CMD=$(echo \"$INPUT\" | jq -r '.tool_input.command // empty'); if echo \"$CMD\" | grep -qE '^gh pr create'; then '/Users/jeffwaters/mywalnut/.codex/hooks/pre-pr-security.sh'; fi",
            "timeout": 60,
            "statusMessage": "Running security scan before PR..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jeffwaters/mywalnut/.codex/hooks/post-edit-typecheck.sh'",
            "timeout": 30,
            "statusMessage": "Type checking..."
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jeffwaters/mywalnut/.codex/hooks/post-worktree-env.sh'",
            "timeout": 10,
            "statusMessage": "Symlinking .env.local to worktree..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jeffwaters/mywalnut/.codex/hooks/session-start-env.sh'",
            "timeout": 5,
            "statusMessage": "Ensuring worktree .env.local..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/jeffwaters/mywalnut/.codex/hooks/session-end-update-docs.sh'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "'/Users/jeffwaters/mywalnut/.codex/hooks/notify.sh'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
